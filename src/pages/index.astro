---
import Base from "../layouts/Base.astro";
import ProjectList from "../components/ProjectList.astro";
import { featuredProjects } from "../data/projects";
import { email, socials } from "../data/site";

const description =
  "Joshua Young lives in San Francisco and builds Faber. He is from Cincinnati.";
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Joshua Young",
  url: "https://joshuabyoung.me",
  email,
  homeLocation: {
    "@type": "Place",
    name: "San Francisco",
  },
  sameAs: socials.map((item) => item.href),
};
---

<Base title="Joshua Young" description={description}>
  <section class="hero">
    <h1>Joshua Young</h1>
    <p class="dek">Traveler, hiker, classicist.</p>
    <p class="intro">
      From Cincinnati. I live in San Francisco, where I build <a href="https://getfaber.co" target="_blank" rel="noreferrer noopener">Faber</a>.
    </p>
  </section>

  <div class="section-row">
    <h2 class="kicker">Selected work</h2>
    <a href="/work">All work</a>
  </div>
  <ProjectList projects={featuredProjects} heading="h3" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />
</Base>
