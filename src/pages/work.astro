---
import Base from "../layouts/Base.astro";
import ProjectList from "../components/ProjectList.astro";
import { currentProjects, earlierProjects } from "../data/projects";

const description = "Software by Joshua Young, including Straude, Flyme, Hermes, and lerobot404.";
---

<Base title="Work" description={description}>
  <h1 class="page-title">Work</h1>
  <p class="lede">Things I've built and shipped. The newer work is first.</p>
  <ProjectList projects={currentProjects} />
  <h2 class="section-label">Earlier</h2>
  <ProjectList projects={earlierProjects} heading="h3" />
</Base>
